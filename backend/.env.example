APP_NAME=Chat Support System
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/chat_support
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE_SECONDS=1800
REQUIRE_DB_AT_HEAD=false
# REQUIRED IN PRODUCTION — long random string (Docker: set in deploy/.env)
JWT_SECRET_KEY=super-secret-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=https://yourdomain.com,http://localhost:4746
CORS_ALLOW_ALL=false
# This admin can reset other admins' passwords via /api/admin/admins/{id}/password
SUPER_ADMIN_EMAIL=admin@example.com
# REQUIRED IN PRODUCTION — change from default
SUPER_ADMIN_PASSWORD=Admin@12345
# Optional: false = seed only admin (no demo projects). true = demo only when projects table is empty.
# SEED_DEMO_PROJECTS=true
