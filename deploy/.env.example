# Database
POSTGRES_PASSWORD=change-me-to-strong-password

# JWT Authentication — REQUIRED IN PRODUCTION (Docker Compose will fail if unset)
JWT_SECRET_KEY=change-me-to-random-string-64-chars

# Admin bootstrap — REQUIRED IN PRODUCTION — use a strong unique password
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=YOUR_STRONG_PASSWORD_HERE

# Startup seed: set false on a long-lived server so only the admin user is auto-ensured (no demo projects).
# With true (default), demo projects are still skipped if you already have any project in the DB.
# SEED_DEMO_PROJECTS=true

# CORS — set your public HTTPS origin. Current VPS public URL:
# https://89.116.228.210/ . Replace this if you later attach a domain.
CORS_ORIGINS=https://89.116.228.210

# Set to true to allow any origin (dev/demo only)
# CORS_ALLOW_ALL=false

# Docker nginx bind target:
# - internal host-local bridge behind host TLS (recommended): 127.0.0.1:4746:83
# - direct public exposure (not recommended): 4746:83
# Never browse to :4746 directly; use the public HTTPS root URL instead.
NGINX_PORT_BIND=127.0.0.1:4746:83

# DB pool tuning for websocket/chat concurrency (30-50+ users)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE_SECONDS=1800

# Fail fast on startup if DB schema is not migrated to Alembic head
REQUIRE_DB_AT_HEAD=true

# Frontend (optional – when API/WS are on a different host than the app)
# Leave empty for same-origin (current VPS: https://89.116.228.210). Set only when
# frontend is served from another domain/host than the API.
# NEXT_PUBLIC_API_BASE=https://api.yourdomain.com
# NEXT_PUBLIC_WS_BASE=wss://api.yourdomain.com
